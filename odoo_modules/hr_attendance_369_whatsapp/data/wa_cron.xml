<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Sends the queued "@Employee present 9:30 AM" posts. A check-in
            triggers it straight away; the 5-minute interval is only the safety
            net for a trigger that was lost (a restart, a busy worker).
            Harmless when the feature is off: nothing is ever queued.
        -->
        <record id="ir_cron_wa_post_present" model="ir.cron">
            <field name="name">Attendance: post check-ins to WhatsApp group</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_wa_post_present()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Sends each company's daily summary to its Send To numbers once the
            Send At time has come. Checks every 5 minutes; does nothing while
            Send Daily Summary is off or the day's summary has gone out.
        -->
        <record id="ir_cron_wa_daily_summary" model="ir.cron">
            <field name="name">Attendance: send daily WhatsApp summary</field>
            <field name="model_id" ref="model_hr_attendance_wa_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_wa_daily_summary()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
