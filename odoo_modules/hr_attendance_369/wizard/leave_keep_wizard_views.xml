<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_leave_keep_wizard_form" model="ir.ui.view">
        <field name="name">hr.leave.keep.wizard.form</field>
        <field name="model">hr.leave.keep.wizard</field>
        <field name="arch" type="xml">
            <form string="Keep Leave">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <p class="mb-1">
                            <strong><field name="employee_name" readonly="1" nolabel="1" class="oe_inline"/></strong>
                            asked to cancel this approved leave:
                        </p>
                        <p class="mb-0"><field name="cancel_reason" readonly="1" nolabel="1"/></p>
                    </div>
                    <group>
                        <field name="leave_id" invisible="1"/>
                        <field name="reason"
                               required="1"
                               placeholder="The employee sees this, so make it useful (e.g. the project deadline falls on these days)..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_keep"
                            type="object"
                            string="Keep Leave"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_keep_wizard" model="ir.actions.act_window">
        <field name="name">Keep Leave</field>
        <field name="res_model">hr.leave.keep.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
