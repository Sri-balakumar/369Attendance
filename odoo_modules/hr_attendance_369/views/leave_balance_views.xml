<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Leave Balances: one row per employee, answering "who has what left".

        Every figure is computed, never stored, and batched in one pass (see
        hr_employee._compute_leave_balances) so the list costs a fixed number
        of queries however many employees it covers. That also means the
        columns cannot be sorted or filtered on. They are a read-out, and the
        underlying records are where the detail lives.

        The year comes from `balance_year` in the action context below.
    -->

    <record id="view_employee_leave_balance_tree" model="ir.ui.view">
        <field name="name">hr.employee.leave.balance.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Leave Balances" create="false" delete="false"
                  decoration-info="comp_off_balance &gt; 0">
                <field name="name"/>
                <field name="department_id" optional="show"/>
                <field name="job_title" optional="hide"/>
                <field name="paid_leave_allowed" string="Allowed" sum="Allowed"/>
                <field name="paid_leave_taken" string="Leave Taken" sum="Taken"/>
                <field name="paid_leave_remaining" string="Paid Leave Left"
                       sum="Left"/>
                <field name="comp_off_earned" string="Comp Off Earned"
                       sum="Earned"/>
                <field name="comp_off_used" string="Comp Off Used" sum="Used"/>
                <field name="comp_off_balance" string="Comp Off Left"
                       sum="Comp Off Left"/>
                <button name="action_view_comp_off_credits" type="object"
                        string="Credits" icon="fa-list-ul"
                        title="Open this employee's compensatory-off ledger"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_employee_leave_balance" model="ir.actions.act_window">
        <field name="name">Leave Balances</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_employee_leave_balance_tree"/>
        <field name="domain">[('active', '=', True)]</field>
        <!-- context_today() rather than a hardcoded year: the figures are
             per calendar year, and a literal would silently go stale on
             1 January. -->
        <field name="context">{'balance_year': context_today().year, 'guide_key': 'leave_balances'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employees to show
            </p>
            <p>
                Paid leave comes from the yearly allowance in the leave policy.
                Compensatory off is earned by working weekly offs and public
                holidays, and is counted separately: taking one spends no
                paid-leave allowance.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  The same two numbers on the employee's own form             -->
    <!-- ============================================================ -->
    <record id="view_employee_form_inherit_comp_off" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.comp.off</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_comp_off_credits" type="object"
                        class="oe_stat_button" icon="fa-calendar-plus-o"
                        groups="hr.group_hr_user">
                    <field name="comp_off_balance" widget="statinfo"
                           string="Comp Off"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
