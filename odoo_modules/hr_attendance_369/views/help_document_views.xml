<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_help_document_list" model="ir.ui.view">
        <field name="name">attendance.help.document.list</field>
        <field name="model">attendance.help.document</field>
        <field name="arch" type="xml">
            <list string="Help Documents">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="description"/>
                <field name="section" optional="hide"/>
                <field name="audience" widget="badge" optional="show"
                       column_invisible="context.get('default_section') != 'app'"/>
                <field name="pdf_filename" string="PDF"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="write_date" string="Last updated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_help_document_form" model="ir.ui.view">
        <field name="name">attendance.help.document.form</field>
        <field name="model">attendance.help.document</field>
        <field name="arch" type="xml">
            <form string="Help Document">
                <sheet>
                    <div class="alert alert-warning" role="status">
                        Upload a <b>PDF</b> (and optionally write HTML content). It appears as a card in the
                        <b>Help</b> menu; "Open guide" shows it in the browser and "Open in PDF doc" opens the full PDF.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="section"/>
                            <!-- Only app manuals are split by role; the module's
                                 guides are one shelf everybody shares. -->
                            <field name="audience" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="section != 'app'"/>
                        </group>
                    </group>
                    <group string="PDF">
                        <field name="pdf_file" widget="binary" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="pdf_static_path"
                               placeholder="/hr_attendance_369/static/src/docs/your.pdf (for bundled PDFs)"/>
                    </group>
                    <group string="HTML Content (optional — shown instead of the PDF on 'Open guide')">
                        <field name="html_content" nolabel="1" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_help_document" model="ir.actions.act_window">
        <field name="name">Help Documents</field>
        <field name="res_model">attendance.help.document</field>
        <field name="domain">[('section', '=', 'manual')]</field>
        <field name="context">{'guide_key': 'help_documents', 'default_section': 'manual'}</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Help > Mobile App: the PDFs the 369 Attendance app lists under
         Settings > App Manual. One action per shelf, so a new document lands on
         the shelf you were already in. -->
    <record id="action_help_document_app" model="ir.actions.act_window">
        <field name="name">Mobile App</field>
        <field name="res_model">attendance.help.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('section', '=', 'app')]</field>
        <field name="context">{'default_section': 'app', 'default_icon': '📱'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload the app's manuals.</p>
            <p>
                The PDFs for the 369 Attendance phone app. They open on the phone
                under <b>Settings &gt; App Manual</b>, and changes reach every
                device without a new app build.
            </p>
            <p>
                <b>Shown to</b> decides who sees each one: <b>Admin</b>,
                <b>HR</b>, <b>Employee</b>, or <b>Everyone</b>. Admins see all of
                them.
            </p>
        </field>
    </record>

    <!-- The "Help Documents" menuitem now lives in views/menu.xml with every
         other menu in this module. -->

</odoo>
