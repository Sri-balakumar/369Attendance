<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Leave Config - List View -->
    <record id="view_leave_config_list" model="ir.ui.view">
        <field name="name">hr.leave.config.list</field>
        <field name="model">hr.leave.config</field>
        <field name="arch" type="xml">
            <list string="Leave Configuration">
                <field name="company_id"/>
                <field name="paid_leave_enabled"/>
                <field name="paid_leave_days_per_year"/>
                <field name="paid_leave_days_per_month"/>
                <field name="unpaid_leave_deduction_enabled"/>
            </list>
        </field>
    </record>

    <!-- Leave Config - Form View -->
    <record id="view_leave_config_form" model="ir.ui.view">
        <field name="name">hr.leave.config.form</field>
        <field name="model">hr.leave.config</field>
        <field name="arch" type="xml">
            <form string="Leave Configuration">
                <sheet>
                    <group>
                        <field name="company_id"/>
                    </group>

                    <group string="Paid Leave Settings">
                        <group>
                            <field name="paid_leave_enabled"/>
                            <field name="paid_leave_days_per_year"/>
                            <field name="paid_leave_days_per_month"/>
                        </group>
                        <!-- Paid-leave carry forward is stored but not applied
                             anywhere, so it is hidden rather than offered.
                             Comp-off carry forward below is real. -->
                        <group invisible="1">
                            <field name="carry_forward_enabled"/>
                            <field name="max_carry_forward_days"/>
                        </group>
                    </group>

                    <group string="Compensatory Off Settings">
                        <group>
                            <field name="comp_off_enabled"/>
                            <field name="comp_off_expiry_days"
                                   invisible="not comp_off_enabled"/>
                        </group>
                        <group>
                            <field name="comp_off_carry_forward_enabled"
                                   invisible="not comp_off_enabled"/>
                            <field name="comp_off_max_carry_forward_days"
                                   invisible="not comp_off_enabled or not comp_off_carry_forward_enabled"/>
                        </group>
                    </group>

                    <group string="Notifications">
                        <group>
                            <field name="notify_on_submit"/>
                        </group>
                        <group>
                            <field name="notify_emails"
                                   invisible="not notify_on_submit"
                                   placeholder="hr@example.com, manager@example.com"/>
                        </group>
                    </group>
                    <div invisible="not notify_on_submit" class="mb-3">
                        <div class="text-muted small mb-1">Email preview, with a sample request. This is exactly what HR receives.</div>
                        <div class="border rounded p-3 bg-white">
                            <field name="notify_preview_html" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <group string="Unpaid Leave / Deduction Settings">
                        <group>
                            <field name="unpaid_leave_deduction_enabled"/>
                        </group>
                    </group>

                    <div class="alert alert-warning mt-3" role="alert">
                        <strong>How paid and unpaid leave are worked out</strong>
                        <ul class="mb-0">
                            <li>Each employee gets the paid leave days set per year, and per month.</li>
                            <li>Once an employee has used up their paid leave, further leave becomes <b>unpaid</b>.</li>
                            <li>Unpaid leave deduction = <b>Employee Monthly Wage ÷ Working Days in Month</b>.</li>
                            <li>Half day unpaid = half the daily rate.</li>
                            <li>Changes apply to requests decided from now on.</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Leave Config - Action -->
    <record id="action_leave_config" model="ir.actions.act_window">
        <field name="name">Leave Policy Configuration</field>
        <field name="res_model">hr.leave.config</field>
        <field name="context">{'guide_key': 'leave_policy'}</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
