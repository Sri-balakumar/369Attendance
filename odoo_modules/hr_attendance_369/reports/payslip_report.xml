<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Follows the pattern of employee_report_pdf.xml: the action and its
        template live in the same file, report_name and report_file are
        identical and module-qualified, and the existing paperformat is reused
        rather than adding another.

        No binding_model_id on purpose, so this does not clutter the Print
        menu of unrelated models; it is reached from the buttons on the
        payslip and the run.
    -->
    <record id="action_report_payslip" model="ir.actions.report">
        <field name="name">Payslip</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_attendance_369.report_payslip</field>
        <field name="report_file">hr_attendance_369.report_payslip</field>
        <field name="print_report_name">'Payslip - %s - %s' % (object.employee_name or '', (object.date_from and object.date_from.strftime('%B %Y')) or '')</field>
        <field name="paperformat_id" ref="hr_attendance_369.paperformat_employee_report"/>
    </record>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Times New Roman', Times, serif; color: #222;">

                        <div style="text-align: center; margin-bottom: 14px;">
                            <div style="font-size: 16px; font-weight: bold; letter-spacing: 1px; color: #875A7B;">
                                PAYSLIP FOR <span t-esc="doc.date_from.strftime('%B %Y').upper()"/>
                            </div>
                            <div style="font-size: 10px; color: #666;">
                                Pay Period
                                <span t-field="doc.date_from" t-options="{'widget': 'date'}"/>
                                to
                                <span t-field="doc.date_to" t-options="{'widget': 'date'}"/>
                                <span t-if="doc.pay_date">
                                    &#183; Pay Date <span t-field="doc.pay_date" t-options="{'widget': 'date'}"/>
                                </span>
                            </div>
                        </div>

                        <!-- Employee -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 10px;">
                            <tr>
                                <td style="padding: 3px 6px; border: 1px solid #ddd; width: 22%;"><b>Employee</b></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd; width: 28%;"><span t-esc="doc.employee_name"/></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd; width: 22%;"><b>Designation</b></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><span t-esc="doc.job_title or '-'"/></td>
                            </tr>
                            <tr>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><b>Department</b></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><span t-esc="doc.department_name or '-'"/></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><b>Date of Joining</b></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;">
                                    <span t-if="doc.employee_id.sudo().contract_date_start"
                                          t-field="doc.employee_id.sudo().contract_date_start"
                                          t-options="{'widget': 'date'}"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                        </table>

                        <!-- Statutory identifiers: only the ACTIVE types the
                             company actually keeps. Nothing prints when none
                             are switched on. -->
                        <t t-set="ids" t-value="doc.employee_id.sudo().statutory_id_ids.filtered(lambda l: l.type_active and l.value)"/>
                        <table t-if="ids" style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 10px;">
                            <tr t-foreach="ids" t-as="sid">
                                <td style="padding: 3px 6px; border: 1px solid #ddd; width: 22%;"><b><span t-esc="sid.type_id.name"/></b></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><span t-esc="sid.value"/></td>
                            </tr>
                        </table>

                        <!-- Attendance for the period -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 10px;">
                            <tr style="background-color: #f6f2f5;">
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><b>Working Days</b></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><b>Paid Days</b></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><b>LOP Days</b></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><b>Leave Taken</b></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><t t-esc="'%g' % doc.working_days"/></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><t t-esc="'%g' % doc.paid_days"/></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;" t-attf-style="#{doc.lop_days &gt; 0 and 'color:#e74c3c; font-weight:bold;' or ''}"><t t-esc="'%g' % doc.lop_days"/></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: center;"><t t-esc="'%g' % (doc.leave_days_paid + doc.leave_days_unpaid)"/></td>
                            </tr>
                        </table>

                        <!-- Earnings and deductions, side by side -->
                        <t t-set="earnings" t-value="doc.line_ids.filtered(lambda l: l.category == 'earning')"/>
                        <t t-set="deductions" t-value="doc.line_ids.filtered(lambda l: l.category == 'deduction')"/>
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                            <tr style="background-color: #875A7B; color: #fff;">
                                <td style="padding: 5px 6px; border: 1px solid #ddd; width: 32%;"><b>EARNINGS</b></td>
                                <td style="padding: 5px 6px; border: 1px solid #ddd; text-align: right; width: 18%;"><b>Amount</b></td>
                                <td style="padding: 5px 6px; border: 1px solid #ddd; width: 32%;"><b>DEDUCTIONS</b></td>
                                <td style="padding: 5px 6px; border: 1px solid #ddd; text-align: right; width: 18%;"><b>Amount</b></td>
                            </tr>
                            <tr t-foreach="range(max(len(earnings), len(deductions), 1))" t-as="row">
                                <t t-set="e" t-value="earnings[row] if row &lt; len(earnings) else None"/>
                                <t t-set="d" t-value="deductions[row] if row &lt; len(deductions) else None"/>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><span t-if="e" t-esc="e.name"/></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd; text-align: right;">
                                    <span t-if="e" t-field="e.amount"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd;"><span t-if="d" t-esc="d.name"/></td>
                                <td style="padding: 3px 6px; border: 1px solid #ddd; text-align: right;">
                                    <span t-if="d" t-field="d.amount"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                            <tr style="background-color: #f6f2f5;">
                                <td style="padding: 5px 6px; border: 1px solid #ccc;"><b>Gross Earnings</b></td>
                                <td style="padding: 5px 6px; border: 1px solid #ccc; text-align: right;">
                                    <b><span t-field="doc.gross_earnings"
                                             t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></b>
                                </td>
                                <td style="padding: 5px 6px; border: 1px solid #ccc;"><b>Total Deductions</b></td>
                                <td style="padding: 5px 6px; border: 1px solid #ccc; text-align: right; color: #e74c3c;">
                                    <b><span t-field="doc.total_deductions"
                                             t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></b>
                                </td>
                            </tr>
                        </table>

                        <!-- Net -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px;">
                            <tr style="background-color: #f6f2f5;">
                                <td style="padding: 8px 6px; border: 2px solid #875A7B;"><b>NET PAY</b></td>
                                <td style="padding: 8px 6px; border: 2px solid #875A7B; text-align: right; color: #1e7e34;">
                                    <b><span t-field="doc.net_pay_rounded"
                                             t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></b>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding: 5px 6px; border: 1px solid #ddd; font-size: 11px; font-style: italic;">
                                    <span t-esc="doc.net_in_words"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Leave -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px;">
                            <tr style="background-color: #f6f2f5;">
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><b>Leave Opening</b></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><b>Taken</b></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><b>Closing</b></td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><t t-esc="'%g' % doc.leave_opening"/></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><t t-esc="'%g' % doc.leave_taken"/></td>
                                <td style="padding: 4px 6px; border: 1px solid #ddd;"><t t-esc="'%g' % doc.leave_closing"/></td>
                            </tr>
                        </table>

                        <div style="margin-top: 16px; font-size: 9px; color: #888; text-align: center;">
                            This is a computer-generated payslip and does not require a signature.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
