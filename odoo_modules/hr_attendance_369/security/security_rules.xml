        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="employee_qualification_rule_manager" model="ir.rule">
        <field name="name">Qualification: HR sees all</field>
        <field name="model_id" ref="model_hr_employee_qualification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="employee_previous_employment_rule_employee" model="ir.rule">
        <field name="name">Previous Employment: Employee sees own only</field>
        <field name="model_id" ref="model_hr_employee_previous_employment"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
