    <!-- ============================================================ -->
    <!--                    EMPLOYEE DETAILS                          -->
    <!-- ============================================================ -->
    <!--
        Employees maintain these rows themselves from My Profile, which is
        why ir.model.access.csv grants base.group_user write on them. That
        grant is only safe BECAUSE of the rules below: without them, write
        access on a shared model lets any employee edit any colleague's rows.
        The two always ship together.

        hr.employee.salary.line deliberately has neither an ACL row nor a
        rule for base.group_user, because salary is not self-service at all, so an
        ordinary user cannot reach it by any path.
    -->

    <record id="employee_statutory_id_rule_employee" model="ir.rule">
        <field name="name">Statutory Identifier: Employee sees own only</field>
        <field name="model_id" ref="model_hr_employee_statutory_id"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="employee_statutory_id_rule_manager" model="ir.rule">
        <field name="name">Statutory Identifier: HR sees all</field>
        <field name="model_id" ref="model_hr_employee_statutory_id"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

