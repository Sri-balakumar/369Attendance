        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="employee_previous_employment_rule_manager" model="ir.rule">
        <field name="name">Previous Employment: HR sees all</field>
        <field name="model_id" ref="model_hr_employee_previous_employment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
