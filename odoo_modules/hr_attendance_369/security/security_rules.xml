    </record>

    <!--
        employee.device grants base.group_user WRITE (the phone updates
        last_used and device_name), which without a rule let any employee
        rewrite a colleague's row, including repointing device_id at their
        own handset. No create: enrolment stays with HR.
    -->
    <record id="employee_device_rule_employee" model="ir.rule">
        <field name="name">Employee Device: Employee sees own only</field>
        <field name="model_id" ref="model_employee_device"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
