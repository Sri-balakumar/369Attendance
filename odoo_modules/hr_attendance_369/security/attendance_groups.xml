<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Merged from the former hr_leave_request and hr_wfh_request addons.
         Approval rights stay separate: a Leave Manager is not automatically a
         WFH Manager, which is how the two modules behaved before. -->

    <record id="group_leave_manager" model="res.groups">
        <field name="name">Leave Manager</field>
        <field name="comment">Users who can approve or reject leave requests</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_wfh_manager" model="res.groups">
        <field name="name">WFH Manager</field>
        <field name="comment">Users who can approve or reject Work From Home requests</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
